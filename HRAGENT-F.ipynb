   "metadata": {},
   "source": [
    "## Cell 4 — Trace Helpers & Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "cell-helpers",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Trace helpers ready!\n"
     ]
    }
   ],
   "source": [
    "# ── TraceContext ─────────────────────────────────────────────────────\n",
    "class TraceContext:\n",
    "    \"\"\"Tracks a single user request end-to-end.\"\"\"\n",
    "    def __init__(self):\n",
    "        self.trace_uuid  = str(uuid.uuid4())\n",
    "        self.trace_id    = self.trace_uuid[:8].upper()   # short ID for display\n",
    "        self.start_time  = time.time()\n",
    "        self.events      = []\n",
    "\n",
    "    def add_event(self, step, step_type, details):\n",
    "        self.events.append({\n",
    "            \"trace_id\":  self.trace_id,\n",
    "            \"timestamp\": datetime.now().isoformat(),\n",
    "            \"step\":      step,\n",
    "            \"type\":      step_type,\n",
    "            \"details\":   details\n",
    "        })\n",
    "\n",
    "    def duration(self):\n",
    "        return time.time() - self.start_time\n",
    "\n",
    "    def save_trace(self):\n",
    "        with open(TRACE_LOG_FILE, \"a\") as f:\n",
    "            for event in self.events:\n",
    "                f.write(json.dumps(event) + \"\\n\")\n",
    "\n",
    "\n",
    "# ── Metrics updater ──────────────────────────────────────────────────\n",
    "def update_metrics(agent=None, tool=None, error=None):\n",
    "    METRICS_STORE[\"total_requests\"] += 1\n",
    "    if agent:\n",
    "        METRICS_STORE[\"agent_requests\"][agent] = METRICS_STORE[\"agent_requests\"].get(agent, 0) + 1\n",
    "    if tool:\n",
    "        METRICS_STORE[\"tool_calls\"][tool]       = METRICS_STORE[\"tool_calls\"].get(tool, 0) + 1\n",
    "        METRICS_STORE[\"total_tool_calls\"]       += 1\n",
    "    if error:\n",
    "        METRICS_STORE[\"total_errors\"]           += 1\n",
    "        METRICS_STORE[\"errors_by_type\"][error]  = METRICS_STORE[\"errors_by_type\"].get(error, 0) + 1\n",
    "\n",
    "\n",
    "# ── LangSmith logger ─────────────────────────────────────────────────\n",
    "def log_to_langsmith(run_type, name, inputs, outputs, error=None):\n",
    "    if not LANGSMITH_ENABLED:\n",
    "        return\n",
    "    try:\n",
    "        from datetime import timezone\n",
    "        now     = datetime.now(timezone.utc)\n",
    "        run_id  = str(uuid.uuid4())\n",
    "        valid   = [\"llm\",\"chain\",\"tool\",\"retriever\",\"embedding\",\"prompt\",\"parser\"]\n",
    "        ls_type = run_type if run_type in valid else \"chain\"\n",
    "\n",
    "        run_dict = {\n",
    "            \"id\":         run_id,\n",
    "            \"name\":       name,\n",
    "            \"run_type\":   ls_type,\n",
    "            \"inputs\":     inputs,\n",
    "            \"outputs\":    outputs if not error else {\"error\": str(error)},\n",
    "            \"error\":      str(error) if error else None,\n",
    "            \"start_time\": now.isoformat(),\n",
    "            \"end_time\":   now.isoformat(),\n",
    "            \"trace_id\":   run_id,\n",
    "            \"tags\":       [\"hr-multiagent\"],\n",
    "            \"extra\":      {\"model\": \"qwen2.5:0.5b\"},\n",
    "            \"serialized\": {\"name\": name, \"run_type\": ls_type}\n",
    "        }\n",
    "        langsmith_client.batch_ingest_runs(create=[run_dict])\n",
    "    except Exception:\n",
    "        pass   # Never crash the main flow because of observability\n",
    "\n",
    "\n",
    "# ── Dashboard ────────────────────────────────────────────────────────\n",
    "def show_observability_dashboard():\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"📊 HR SYSTEM OBSERVABILITY DASHBOARD\")\n",
    "    print(\"=\"*60)\n",
    "    print(f\"  Total Requests  : {METRICS_STORE['total_requests']}\")\n",
    "    print(f\"  Total Tool Calls: {METRICS_STORE['total_tool_calls']}\")\n",
    "    print(f\"  Total Errors    : {METRICS_STORE['total_errors']}\")\n",
    "\n",
    "    if METRICS_STORE['agent_requests']:\n",
    "        print(\"\\n  🤖 Agent Breakdown:\")\n",
    "        for a, c in METRICS_STORE['agent_requests'].items():\n",
    "            print(f\"     {a}: {c} request(s)\")\n",
    "\n",
    "    if METRICS_STORE['tool_calls']:\n",
    "        print(\"\\n  🔧 Tool Breakdown:\")\n",
    "        for t, c in METRICS_STORE['tool_calls'].items():\n",
    "            print(f\"     {t}: {c} call(s)\")\n",
    "\n",
    "    if LANGSMITH_ENABLED:\n",
    "        print(f\"\\n  🔗 LangSmith: https://smith.langchain.com/ (Project: {LANGSMITH_PROJECT})\")\n",
    "    print(\"=\"*60 + \"\\n\")\n",
    "\n",
    "\n",
    "def show_recent_traces(limit=5):\n",
    "    if not Path(TRACE_LOG_FILE).exists():\n",
    "        print(\"No traces yet.\")\n",
    "        return\n",
    "    traces = {}\n",
    "    with open(TRACE_LOG_FILE) as f:\n",
    "        for line in f:\n",
    "            e = json.loads(line)\n",
    "            traces.setdefault(e[\"trace_id\"], []).append(e)\n",
    "\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"📜 RECENT TRACES\")\n",
    "    print(\"=\"*60)\n",
    "    for tid in list(traces.keys())[-limit:]:\n",
    "        evts   = traces[tid]\n",
    "        inp    = next((e[\"details\"].get(\"user_input\",\"?\") for e in evts if e[\"type\"]==\"user_input\"), \"?\")\n",
    "        err    = any(e[\"type\"]==\"error\" for e in evts)\n",
    "        status = \"❌ ERROR\" if err else \"✅ SUCCESS\"\n",
    "        print(f\"  Trace {tid}: {status}\")\n",
    "        print(f\"  Input : {inp[:70]}\")\n",
    "        print(f\"  Events: {len(evts)}\")\n",
    "        print(\"─\"*60)\n",
    "    print()\n",
    "\n",
    "print(\"✅ Trace helpers ready!\")"
   ]
  },
