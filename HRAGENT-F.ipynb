   "source": [
    "## Cell 6 — Create 3 Sub-Agents"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-subagents",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Policy Agent created\n",
      "✅ Leave Agent created (with manual tool handling)\n",
      "✅ Onboarding Agent created\n",
      "\n",
      "🎉 All 3 sub-agents ready!\n",
      "\n",
      "--- Testing Leave Agent ---\n",
      "Test result: 📝 To apply for leave, please provide: your full name.\n",
      "\n",
      "Example: 'Apply leave for John Doe from 2025-12-20 to 2025-12-27 for family vacation'\n"
     ]
    }
   ],
   "source": [
    "from strands import Agent\n",
    "from strands.models.ollama import OllamaModel\n",
    "import json\n",
    "\n",
    "model = OllamaModel(host=\"http://localhost:11434\", model_id=\"qwen2.5:0.5b\")\n",
    "\n",
    "# ── Policy Agent \n",
    "policy_agent = Agent(\n",
    "    model=model,\n",
    "    system_prompt=\"\"\"You are an HR Policy expert for HCL Corp.\n",
    "\n",
    "KEY POLICIES:\n",
    "- WFH: up to 3 days/week with manager approval, not allowed in first 3 months\n",
    "- Annual leave: 21 days/year | Sick leave: 10 days/year\n",
    "- Health insurance: employee + family\n",
    "- Learning budget: INR 25,000/year\n",
    "- PF: 12% of basic salary\n",
    "\n",
    "Answer the employee's question directly and concisely using the policy above.\"\"\"\n",
    ")\n",
    "print(\"✅ Policy Agent created\")\n",
    "\n",
    "# ── Leave Agent \n",
    "def handle_leave_request(user_message):\n",
    "    \"\"\"Manually parse and handle leave requests - NO model decision needed\"\"\"\n",
    "    message_lower = user_message.lower()\n",
    "    \n",
    "    # Try to extract information\n",
    "    import re\n",
    "    \n",
    "    # Look for name patterns\n",
    "    name_match = re.search(r'name is (\\w+ \\w+)', user_message, re.IGNORECASE)\n",
    "    if not name_match:\n",
    "        name_match = re.search(r'(\\w+ \\w+)(?=\\'s leave| wants| applied)', user_message, re.IGNORECASE)\n",
    "    \n",
    "    employee_name = name_match.group(1) if name_match else None\n",
    "    \n",
    "    # Look for dates\n",
    "    date_pattern = r'(\\d{4}-\\d{2}-\\d{2})'\n",
    "    dates = re.findall(date_pattern, user_message)\n",
    "    start_date = dates[0] if len(dates) > 0 else None\n",
    "    end_date = dates[1] if len(dates) > 1 else None\n",
    "    \n",
    "    # Look for reason\n",
    "    reason_match = re.search(r'reason is (\\w+(?: \\w+)*)', user_message, re.IGNORECASE)\n",
    "    reason = reason_match.group(1) if reason_match else \"Not specified\"\n",
    "    \n",
    "    # Check if we have all info\n",
    "    if employee_name and start_date and end_date:\n",
    "        # Call apply_leave tool directly\n",
    "        result = apply_leave(employee_name, start_date, end_date, reason)\n",
    "        result_data = json.loads(result)\n",
    "        return f\"✅ {result_data['message']}\"\n",
    "    else:\n",
    "        # Ask for missing info\n",
    "        missing = []\n",
    "        if not employee_name: missing.append(\"your full name\")\n",
    "        if not start_date: missing.append(\"start date (YYYY-MM-DD)\")\n",
    "        if not end_date: missing.append(\"end date (YYYY-MM-DD)\")\n",
    "        return f\"📝 To apply for leave, please provide: {', '.join(missing)}.\\n\\nExample: 'Apply leave for John Doe from 2025-12-20 to 2025-12-27 for family vacation'\"\n",
    "\n",
    "def check_leave_status(employee_name):\n",
    "    \"\"\"Check leave status manually\"\"\"\n",
    "    result = check_leave(employee_name)\n",
    "    result_data = json.loads(result)\n",
    "    if \"requests\" in result_data:\n",
    "        if not result_data[\"requests\"]:\n",
    "            return f\"📋 No leave requests found for {employee_name}.\"\n",
    "        output = f\"📋 Leave requests for {employee_name}:\\n\"\n",
    "        for req in result_data[\"requests\"]:\n",
    "            output += f\"  • {req['request_id']}: {req['start_date']} to {req['end_date']} - {req['reason']} ({req['status']})\\n\"\n",
    "        return output\n",
    "    return result_data.get(\"message\", \"No records found\")\n",
    "\n",
    "# Create leave agent with custom wrapper\n",
    "class LeaveAgentWrapper:\n",
    "    def __call__(self, message):\n",
    "        # Check if it's a status check\n",
    "        if \"check\" in message.lower() and \"leave\" in message.lower():\n",
    "            import re\n",
    "            name_match = re.search(r'name is (\\w+ \\w+)|for (\\w+ \\w+)', message, re.IGNORECASE)\n",
    "            if name_match:\n",
    "                name = name_match.group(1) or name_match.group(2)\n",
    "                return check_leave_status(name)\n",
    "            return \"Please provide employee name to check leave status.\"\n",
    "        \n",
    "        # Otherwise try to apply for leave\n",
    "        return handle_leave_request(message)\n",
    "\n",
    "leave_agent = LeaveAgentWrapper()\n",
    "print(\"✅ Leave Agent created (with manual tool handling)\")\n",
    "\n",
    "# ── Onboarding Agent \n",
    "onboarding_agent = Agent(\n",
    "    model=model,\n",
    "    system_prompt=\"\"\"You are a warm Onboarding Guide for new HCL Corp employees!\n",
    "\n",
    "DAY 1 CHECKLIST:\n",
    "1. Collect laptop from IT desk, Ground Floor, Building A\n",
    "2. Set up email: firstname.lastname@corp.com\n",
    "3. Complete security training at lms.corp.com\n",
    "4. Attend HR orientation at 10 AM, Conference Room B\n",
    "5. Meet your assigned buddy\n",
    "\n",
    "WEEK 1: Request tool access at it.corp.com, join Slack, submit benefits enrollment\n",
    "\n",
    "Answer the new employee's question warmly with specific, helpful steps.\"\"\"\n",
    ")\n",
    "print(\"✅ Onboarding Agent created\")\n",
    "\n",
    "print(\"\\n🎉 All 3 sub-agents ready!\")\n",
    "\n",
    "# Quick test\n",
    "print(\"\\n--- Testing Leave Agent ---\")\n",
    "test_result = leave_agent(\"Apply leave for Stuti Mishra from 2025-12-20 to 2025-12-27 for family vacation\")\n",
