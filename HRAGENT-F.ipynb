   "source": [
    "## Cell 5 — HR Tools (apply_leave / check_leave)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "cell-tools",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ HR Tools ready!\n",
      "   • apply_leave — saves a new leave request to LEAVE_DB\n",
      "   • check_leave — fetches existing leave records\n"
     ]
    }
   ],
   "source": [
    "import json as _json\n",
    "import uuid  as _uuid\n",
    "from datetime import datetime as _dt\n",
    "from strands import tool\n",
    "\n",
    "LEAVE_DB = {}   # In-memory leave database\n",
    "\n",
    "@tool\n",
    "def apply_leave(employee_name: str, start_date: str, end_date: str, reason: str) -> str:\n",
    "    \"\"\"Apply for employee leave.\n",
    "\n",
    "    Args:\n",
    "        employee_name: Full name of the employee\n",
    "        start_date: Leave start date in YYYY-MM-DD format\n",
    "        end_date: Leave end date in YYYY-MM-DD format\n",
    "        reason: Reason for taking leave\n",
    "\n",
    "    Returns:\n",
    "        Confirmation message with request ID\n",
    "    \"\"\"\n",
    "    try:\n",
    "        request_id = \"LV-\" + str(_uuid.uuid4())[:6].upper()\n",
    "        LEAVE_DB[request_id] = {\n",
    "            \"request_id\": request_id,\n",
    "            \"employee\":   employee_name,\n",
    "            \"start_date\": start_date,\n",
    "            \"end_date\":   end_date,\n",
    "            \"reason\":     reason,\n",
    "            \"status\":     \"Pending Approval\",\n",
    "            \"created_at\": _dt.now().strftime(\"%Y-%m-%d %H:%M\")\n",
    "        }\n",
    "        update_metrics(tool=\"apply_leave\")\n",
    "        log_to_langsmith(\"tool\", \"apply_leave\",\n",
    "                         {\"employee\": employee_name, \"dates\": f\"{start_date} → {end_date}\"},\n",
    "                         {\"request_id\": request_id, \"status\": \"Pending Approval\"})\n",
    "        return _json.dumps({\n",
    "            \"success\":    True,\n",
    "            \"request_id\": request_id,\n",
    "            \"message\":    f\"Leave applied! Request ID: {request_id}. Status: Pending Approval.\"\n",
    "        })\n",
    "    except Exception as e:\n",
    "        update_metrics(error=type(e).__name__)\n",
    "        raise\n",
    "\n",
    "\n",
    "@tool\n",
    "def check_leave(employee_name: str) -> str:\n",
    "    \"\"\"Check leave status for an employee.\n",
    "\n",
    "    Args:\n",
    "        employee_name: Full name of the employee\n",
    "\n",
    "    Returns:\n",
    "        All leave requests for the employee\n",
    "    \"\"\"\n",
    "    try:\n",
    "        records = [v for v in LEAVE_DB.values()\n",
    "                   if v[\"employee\"].lower() == employee_name.lower()]\n",
    "        update_metrics(tool=\"check_leave\")\n",
    "        log_to_langsmith(\"tool\", \"check_leave\",\n",
    "                         {\"employee\": employee_name},\n",
    "                         {\"records_found\": len(records)})\n",
    "        if not records:\n",
    "            return _json.dumps({\"message\": f\"No leave requests found for {employee_name}.\"})\n",
    "        return _json.dumps({\"employee\": employee_name, \"total\": len(records), \"requests\": records})\n",
    "    except Exception as e:\n",
    "        update_metrics(error=type(e).__name__)\n",
    "        raise\n",
    "\n",
    "print(\"✅ HR Tools ready!\")\n",
    "print(\"   • apply_leave — saves a new leave request to LEAVE_DB\")\n",
    "print(\"   • check_leave — fetches existing leave records\")"
   ]
  },
