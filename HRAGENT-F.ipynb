    "from strands import tool\n",
    "\n",
    "model = OllamaModel(host=\"http://localhost:11434\", model_id=\"qwen2.5:0.5b\")\n",
    "\n",
    "# Simple routing functions\n",
    "def ask_policy_agent(question: str) -> str:\n",
    "    \"\"\"Route HR policy questions to the Policy Agent.\"\"\"\n",
    "    update_metrics(agent=\"policy\")\n",
    "    response = policy_agent(question)\n",
    "    return str(response).strip()\n",
    "\n",
    "def ask_leave_agent(request: str) -> str:\n",
    "    \"\"\"Route leave-related requests to the Leave Agent.\"\"\"\n",
    "    update_metrics(agent=\"leave\")\n",
    "    response = leave_agent(request)\n",
    "    return str(response).strip()\n",
    "\n",
    "def ask_onboarding_agent(question: str) -> str:\n",
    "    \"\"\"Route onboarding questions to the Onboarding Agent.\"\"\"\n",
    "    update_metrics(agent=\"onboarding\")\n",
    "    response = onboarding_agent(question)\n",
    "    return str(response).strip()\n",
    "\n",
    "# Create tools\n",
    "ask_policy_tool = tool(ask_policy_agent)\n",
    "ask_leave_tool = tool(ask_leave_agent)\n",
    "ask_onboarding_tool = tool(ask_onboarding_agent)\n",
    "\n",
    "# ── Supervisor ───────────────────────────────────────────────────────\n",
    "supervisor = Agent(\n",
    "    model=model,\n",
    "    system_prompt=\"\"\"You are the HR Supervisor. Route each question to ONE specialist.\n",
    "\n",
    "ROUTING RULES:\n",
    "• Policy (WFH, benefits, leave policy) → ask_policy_agent\n",
    "• Leave (apply, check status) → ask_leave_agent\n",
    "• Onboarding (new joiner, first day) → ask_onboarding_agent\n",
    "\n",
    "Call the appropriate tool with the user's exact question or request.\n",
    "\n",
    "Example:\n",
    "User: \"What is WFH policy?\" → Call ask_policy_agent(\"What is WFH policy?\")\n",
    "User: \"Apply leave for John from Dec 20 to Dec 27\" → Call ask_leave_agent with that request\"\"\",\n",
    "    tools=[ask_policy_tool, ask_leave_tool, ask_onboarding_tool]\n",
    ")\n",
    "\n",
    "print(\"✅ Supervisor Agent ready!\")"
   ]
