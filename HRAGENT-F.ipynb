    "## Cell 8 — `ask()` Helper Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "cell-ask",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ ask() ready!\n"
     ]
    }
   ],
   "source": [
    "import io\n",
    "import contextlib\n",
    "import sys\n",
    "\n",
    "def ask(question):\n",
    "    \"\"\"Ask the HR system.\"\"\"\n",
    "    trace = TraceContext()\n",
    "    \n",
    "    try:\n",
    "        trace.add_event(\"user_request\", \"user_input\", {\"user_input\": question})\n",
    "        \n",
    "        print(\"\\n\" + \"=\"*65)\n",
    "        print(f\"👤  QUESTION : {question}\")\n",
    "        print(f\"🔍  Trace ID : {trace.trace_id}\")\n",
    "        print(\"=\"*65)\n",
    "        \n",
    "        # Get response from supervisor\n",
    "        response = supervisor(question)\n",
    "        \n",
    "        # Extract answer from response\n",
    "        answer = str(response).strip()\n",
    "        \n",
    "        # If answer is too short or looks like tool call, try to get from conversation\n",
    "        if len(answer) < 20 or \"tool\" in answer.lower():\n",
    "            try:\n",
    "                # Look through conversation history for actual response\n",
    "                for msg in supervisor.messages:\n",
    "                    content = msg.get(\"content\", [])\n",
    "                    if isinstance(content, list):\n",
    "                        for block in content:\n",
    "                            if block.get(\"type\") == \"tool_result\":\n",
    "                                for sub in block.get(\"content\", []):\n",
    "                                    if sub.get(\"type\") == \"text\":\n",
    "                                        text = sub.get(\"text\", \"\").strip()\n",
    "                                        if text and len(text) > 10:\n",
    "                                            answer = text\n",
    "                                            break\n",
    "                            elif block.get(\"type\") == \"text\":\n",
    "                                text = block.get(\"text\", \"\").strip()\n",
    "                                if text and len(text) > 20:\n",
    "                                    answer = text\n",
    "            except Exception as e:\n",
    "                pass\n",
    "        \n",
    "        # Clean up answer - remove tool call artifacts\n",
    "        if \"Calling tool:\" in answer:\n",
    "            lines = answer.split('\\n')\n",
    "            answer = '\\n'.join([l for l in lines if not l.startswith('Calling tool:')])\n",
    "        \n",
    "        if not answer or len(answer) < 5:\n",
    "            answer = \"I couldn't process that request. Please rephrase.\"\n",
    "        \n",
    "        print(f\"\\n🤖  ANSWER  :\\n\")\n",
    "        print(answer)\n",
    "        print(\"\\n\" + \"─\"*65)\n",
    "        print(f\"⏱️  {trace.duration():.2f}s\", end=\"\")\n",
    "        print(\"  |  ✅ Logged\" if LANGSMITH_ENABLED else \"\")\n",
    "        print(\"=\"*65 + \"\\n\")\n",
    "        \n",
    "        trace.save_trace()\n",
    "        update_metrics()\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"\\n❌ Error: {e}\\n\")\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "\n",
    "print(\"✅ ask() ready!\")"
   ]
